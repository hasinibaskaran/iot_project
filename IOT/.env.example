# API Security configuration
# The header x-api-key value expected by endpoints for authorization
API_SECRET_KEY=your-header-x-api-key-value

# Fast2SMS Integration (Optional)
# If left blank, the API runs in Mock Sandbox Mode, logging SMS output instead of charging credits
FAST2SMS_API_KEY=

# Gateway Controller Configuration
# The FastAPI Backend Base URL
BACKEND_URL=https://fastapi-python-boilerplate-gokul-9978.vercel.app

# The train number this gateway is associated with (e.g., 12601)
TRAIN_NUMBER=12601

# The duration in seconds between automatic station updates (default is 1800)
STATION_UPDATE_INTERVAL=1800
